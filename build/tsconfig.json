{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Node runs these files by stripping the types,
    // so only syntax it can strip is allowed
    // & relative imports keep their .ts extension.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["**/*", "../rspack.config.ts"],
  "exclude": ["node_modules"]
}
