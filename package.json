{
  "name": "draw",
  "version": "1.0.3",
  "description": "A Champions League draw simulator",
  "keywords": [
    "cl",
    "draw",
    "champions",
    "league",
    "seeding",
    "football",
    "uefa",
    "fifa"
  ],
  "homepage": "https://github.com/inker/draw#readme",
  "bugs": {
    "url": "https://github.com/inker/draw/issues"
  },
  "license": "GPLv3",
  "author": "Anton",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inker/draw.git"
  },
  "imports": {
    "#*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged --allow-empty",
    "lint:js": "eslint --max-warnings=0 --cache src",
    "lint:css": "stylelint './src/**/*.css'",
    "lint": "run-p -c \"lint:css -- {1}\" \"lint:js -- {1}\" --",
    "prettier": "prettier --cache --check .",
    "check-types": "tsc --project tsconfig.json --noEmit",
    "build": "rspack build",
    "start": "rspack serve --env dev",
    "test": "vitest"
  },
  "dependencies": {
    "bowser": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "delay.js": "^2.0.1",
    "dom-to-image": "^2.6.0",
    "file-saver": "^2.0.5",
    "flag-icons": "^7.0.2",
    "html-tags": "^5.0.0",
    "i18n-iso-countries": "^7.7.0",
    "jotai": "^3.0.1",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "memoize-one": "^6.0.0",
    "normalize.css": "^8.0.1",
    "p-limit": "^7.1.0",
    "p-memoize": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-github-btn": "^1.2.2",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@inker/eslint-config-typescript": "^11.0.0",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/dev-server": "^2.2.1",
    "@types/dom-to-image": "^2.6.4",
    "@types/file-saver": "^2.0.5",
    "@types/lodash": "^4.14.180",
    "@types/node": "^24.19.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-rspack-plugin": "^5.0.1",
    "husky": "^9.0.6",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.2.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "ts-checker-rspack-plugin": "^1.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "webpack-bundle-analyzer": "^5.4.0"
  },
  "overrides": {
    "eslint": "$eslint",
    "eslint-plugin-react-hooks": "$eslint-plugin-react-hooks",
    "eslint-plugin-sonarjs": "^4.2.2"
  }
}
