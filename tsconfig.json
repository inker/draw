{
  "compilerOptions": {
    "target": "es2025",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "#*": ["./src/*"]
    },
    "strict": true,
    "jsx": "react-jsx",
    // "noUnusedLocals": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"]
  },
  "include": ["src"]
}
